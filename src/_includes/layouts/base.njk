<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title or "Strategies and Patterns Handbook" }}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.4/css/bulma.min.css" />
    <link rel="stylesheet" href="/assets/styles.css" />
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
    <script src="/pagefind/pagefind-ui.js"></script>
    <script type="module">
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
      mermaid.initialize({ startOnLoad: true });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="section">
      <div class="container">
        <header>
          <nav class="navbar" aria-label="Primary navigation">
            <div class="navbar-brand">
              <a class="navbar-item has-text-weight-semibold" href="/">Strategies and Patterns Handbook</a>
            </div>
            <div class="navbar-menu is-active">
              <div class="navbar-end">
                <div class="navbar-item">
                  <search aria-label="Site search">
                    <div id="search"></div>
                  </search>
                </div>
              </div>
            </div>
          </nav>
        </header>

        <div class="site-layout">
          <aside class="sidebar">
            {% include "components/sidebar-navigation.njk" %}
          </aside>

          <main id="main-content" tabindex="-1"><article class="content" data-pagefind-body>
          <h1>{{ title }}</h1>
          {{ content | safe }}
        </article></main>
        </div>

        <footer class="footer">
          <div class="content has-text-centered">
            <p>Converted from the <a href="/original/index.htm" target="_blank" rel="noopener">original 1997 hypertext edition</a>. &copy; 1997 Object International, Inc. All rights reserved.</p>
            <p><small>Built <time datetime="{{ buildDateIso }}">{{ buildDate }}</time></small></p>
          </div>
        </footer>
      </div>
    </div>
    <script>
      const currentNavigationLink = document.querySelector('.handbook-nav [aria-current="page"]');
      let navigationAncestor = currentNavigationLink?.parentElement;
      while (navigationAncestor) {
        if (navigationAncestor instanceof HTMLDetailsElement) navigationAncestor.open = true;
        navigationAncestor = navigationAncestor.parentElement;
      }

      window.addEventListener('DOMContentLoaded', () =>
        new PagefindUI({ element: '#search', showSubResults: true }));
    </script>
  </body>
</html>
