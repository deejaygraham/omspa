---
permalink: /pattern/index.html
eleventyComputed:
  title: 'List of Patterns'
---

{% set categories = [
  { tag: "the fundamental pattern",  label: "The fundamental pattern" },
  { tag: "transaction patterns",     label: "Transaction patterns" },
  { tag: "aggregate patterns",       label: "Aggregate patterns" },
  { tag: "plan patterns",            label: "Plan patterns" },
  { tag: "interaction patterns",     label: "Interaction patterns" },
  { tag: "device patterns",          label: "Device patterns" }
] %}

{% for cat in categories %}
<h2>{{ cat.label }}</h2>

<ul>
{% for pattern in patterns %}
{% if pattern.tags[0] == cat.tag %}
<li><a href="/pattern/{{ pattern.id | lower | replace('#', '-') }}.html">{{ pattern.id }}.</a> {{ pattern.name }}</li>
{% endif %}
{% endfor %}
</ul>

{% endfor %}

<p><a href="/strategy/index.html">List of strategies</a></p>
