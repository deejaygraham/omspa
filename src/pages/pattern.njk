---
pagination:
  data: patterns
  size: 1
  alias: pattern
permalink: "/{{ pattern.number }}-{{ pattern.name | slug }}-pattern-{{ pattern.tags[0] | slug }}.html"
eleventyComputed:
  title: '#{{ pattern.number }}. "{{ pattern.name }}" Pattern // {{ pattern.tags[0] }}'
---

<h2>{{ pattern.id }}. &quot;{{ pattern.name }}&quot; Pattern // {{ pattern.tags[0] }}</h2>

<p><img src="{{ ('/img/' + pattern.image) | url }}" alt="{{ pattern.image }}"></p>

<h3>Typical object interactions</h3>

{% for item in pattern.typicalInteractions %}
<p>\- {{ item }}</p>
{% endfor %}

<h3>Examples</h3>

{% for item in pattern.examples %}
<p>\- {{ item }}</p>
{% endfor %}

<h3>Combinations</h3>

{% for combo in pattern.combinations %}
<p><a href="{{ ('/' + combo.slug + '.html') | url }}">{{ combo.id }}.</a> &quot;{{ combo.name }}&quot;</p>
{% endfor %}

<h3>Related strategies:</h3>

{% for strategy in pattern.relatedStrategies %}
<p><a href="{{ ('/' + strategy.slug + '.html') | url }}">{{ strategy.id }}.</a> &quot;{{ strategy.name }}&quot; Strategy</p>
{% endfor %}

<p><a href="{{ ('/' + (pattern.tags[0] | slug) + '.html') | url }}">{{ pattern.tags[0] | capitalize }}</a></p>

<p><a href="{{ '/patterns-for-building-object-models.html' | url }}">Patterns for building object models</a></p>
